<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>reviver</AssemblyName>
        <RootNamespace>StoneFlyLabs.Reviver.Console</RootNamespace>
        <VersionPrefix>1.0.0</VersionPrefix>

        <!-- NuGet package metadata -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>reviver</ToolCommandName>
        <PackageId>StoneFlyLabs.Reviver</PackageId>
        <Description>Interactive TUI for triaging and reprocessing Azure Service Bus dead-letter queues.</Description>
        <Authors>StoneFlyLabs</Authors>
        <PackageTags>azure;servicebus;dlq;tui;devops</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageIcon>reviver-package-icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/christopherhouse/Reviver</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageOutputPath>./nupkg</PackageOutputPath>

        <!-- Symbols and source link -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <!-- PackagePath="" = package root; avoids backslash issues on Linux CI -->
        <None Include="..\README.md" Pack="true" PackagePath="" />
        <None Include="..\assets\reviver-package-icon.png" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cocona" Version="2.2.0" />
        <PackageReference Include="Spectre.Console" Version="0.49.1" />
        <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.18.4" />
        <PackageReference Include="Azure.Identity" Version="1.13.2" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

</Project>